<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permissions for accessing photos -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <!-- Permission for camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Feature requirement for camera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    
    <application>
        <activity
            android:name=".ImageEditorActivity"
            android:theme="@style/ImageEditorActivityTheme"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />
            
        <activity
            android:name=".CropActivity"
            android:theme="@style/CropActivityTheme"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ProfileCropActivity"
            android:theme="@style/ImageEditorActivityTheme"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".DrawingActivity"
            android:theme="@style/ImageEditorActivityTheme"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />
            
        <activity
            android:name=".ImageViewerActivity"
            android:theme="@style/ImageEditorActivityTheme"
            android:exported="false"
            android:screenOrientation="portrait" />
        
        <!-- FileProvider for sharing camera images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Custom Glide Module for Fast Thumbnails -->
        <meta-data
            android:name="com.rnturboimagepicker.glide.TurboImagePickerGlideModule"
            android:value="GlideModule" />
    </application>
</manifest>
