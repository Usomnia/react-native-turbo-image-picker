<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External files directory -->
    <external-files-path
        name="external_files"
        path="." />
    <!-- Pictures directory for camera captures -->
    <external-files-path
        name="pictures"
        path="Pictures" />
    <!-- External storage (for Android < 10) -->
    <external-path
        name="external_storage"
        path="." />
    <!-- Pictures in external storage (for Android < 10) -->
    <external-path
        name="external_pictures"
        path="Pictures" />
</paths>






