<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_background">

    <!-- ViewPager2: full screen image swipe, wrapped in PullToDismissLayout -->
    <com.rnturboimagepicker.PullToDismissLayout
        android:id="@+id/pullToDismissLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/editorViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/editor_background" />

    <!-- Top bar overlay -->
    <LinearLayout
        android:id="@+id/topBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/editor_top_gradient">

        <!-- Status bar spacer (filled by WindowInsets) -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- Top bar content row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/editorBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:src="@drawable/ic_editor_back"
                android:contentDescription="뒤로가기"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:scaleType="fitCenter" />

            <!-- Counter label (N / M) -->
            <TextView
                android:id="@+id/editorCounterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="@color/editor_foreground"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="1 / 1" />

            <!-- Send button -->
            <TextView
                android:id="@+id/editorSendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:text="@string/turbo_send"
                android:textColor="@color/editor_foreground"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:background="@null" />

        </RelativeLayout>

        <!-- Extra gradient fade area -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Text Mode Top Bar (Overlay) -->
    <LinearLayout
        android:id="@+id/textModeTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/editor_top_gradient">
        
        <View
            android:id="@+id/textModeStatusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <ImageButton
                android:id="@+id/textModeAddButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_text_add"
                android:contentDescription="텍스트 추가"
                android:padding="12dp"
                android:tint="@color/editor_foreground"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/textModeDeleteAllButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_drawing_delete"
                android:contentDescription="모두 지우기"
                android:padding="12dp"
                android:tint="@color/editor_foreground"
                android:scaleType="centerInside" />
        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- Filter UI Container -->
    <FrameLayout
        android:id="@+id/filterContainerView"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:visibility="gone">

        <!-- Filter overlay background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:background="@color/editor_filter_overlay" />

        <!-- Floating Slider Background -->
        <FrameLayout
            android:id="@+id/sliderBackgroundView"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_slider_capsule">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:gravity="center_vertical"
                android:weightSum="4">
                <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" />
                <View android:layout_width="2dp" android:layout_height="3dp" android:background="#FFEB3B" />
                <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" />
                <View android:layout_width="2dp" android:layout_height="3dp" android:background="#FFEB3B" />
                <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" />
                <View android:layout_width="2dp" android:layout_height="3dp" android:background="#FFEB3B" />
                <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Intensity Slider -->
            <SeekBar
                android:id="@+id/intensitySlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:progressDrawable="@drawable/custom_seekbar_progress"
                android:thumb="@drawable/custom_seekbar_thumb"
                android:max="100"
                android:progress="100"
                android:splitTrack="false" />
        </FrameLayout>

        <!-- Filter RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filterRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="0dp" />

    </FrameLayout>
    
    <!-- Thumbnail List for Multi-image Selection (iOS Parity)
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/editorThumbnailRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:background="#66000000"
        android:visibility="gone" />
    -->

    <!-- Bottom toolbar -->
    <LinearLayout
        android:id="@+id/editorBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/editor_bar_background">

        <!-- Toolbar icons row -->
        <LinearLayout
            android:id="@+id/editorToolbarRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Sparkles / auto fix -->
            <ImageButton
                android:id="@+id/toolEffect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_editor_effect"
                android:background="@null"
                android:contentDescription="필터"
                android:padding="14dp"
                android:scaleType="centerInside" />

            <!-- Crop -->
            <ImageButton
                android:id="@+id/toolCrop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_editor_crop"
                android:background="@null"
                android:contentDescription="자르기"
                android:padding="14dp"
                android:scaleType="centerInside" />

            <!-- Text -->
            <ImageButton
                android:id="@+id/toolText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_editor_text"
                android:background="@null"
                android:contentDescription="텍스트"
                android:padding="14dp"
                android:scaleType="centerInside" />

            <!-- Emoji / face -->
            <ImageButton
                android:id="@+id/toolEmoji"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_editor_emoji"
                android:background="@null"
                android:contentDescription="이모지"
                android:padding="14dp"
                android:scaleType="centerInside" />

            <!-- Draw / pencil -->
            <ImageButton
                android:id="@+id/toolDrawing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_editor_drawing"
                android:background="@null"
                android:contentDescription="그리기"
                android:padding="14dp"
                android:scaleType="centerInside" />


        </LinearLayout>

        <!-- Navigation bar spacer (filled by WindowInsets) -->
        <View
            android:id="@+id/navBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

    <!-- Text Mode Bottom Bar -->
    <LinearLayout
        android:id="@+id/textModeBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/editor_bar_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/textModeCancelButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_close_x"
                android:contentDescription="텍스트 취소"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:tint="@color/editor_foreground" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/turbo_text"
                android:textColor="@color/editor_foreground"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/textModeConfirmButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@string/turbo_confirm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:tint="@color/editor_foreground" />

        </LinearLayout>

        <View
            android:id="@+id/textModeNavBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

    <!-- Effect Mode Bottom Bar -->
    <LinearLayout
        android:id="@+id/effectModeBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/editor_bar_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/effectModeCancelButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_close_x"
                android:contentDescription="효과 취소"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:tint="@color/editor_foreground" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/turbo_effect"
                android:textColor="@color/editor_foreground"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/effectModeConfirmButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@string/turbo_confirm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:tint="@color/editor_foreground" />

        </LinearLayout>

        <View
            android:id="@+id/effectModeNavBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

    <com.rnturboimagepicker.EmojiPickerView
        android:id="@+id/emojiPicker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Selection Badge Container (Floating) -->
    <FrameLayout
        android:id="@+id/editorSelectionBadge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="8dp"
        android:visibility="gone">

        <!-- Unselected state (Circle Border) -->
        <View
            android:id="@+id/editorSelectionBorder"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_border_white_thin" />

        <!-- Selected state (Check/Number) -->
        <TextView
            android:id="@+id/editorSelectionNumber"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/circle_filled_primary"
            android:visibility="gone" />
    </FrameLayout>
    
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:elevation="10dp"
            android:clickable="true"
            android:focusable="true">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white" />
        </FrameLayout>

        </FrameLayout>
    </com.rnturboimagepicker.PullToDismissLayout>
</FrameLayout>
