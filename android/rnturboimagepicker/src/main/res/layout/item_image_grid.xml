<?xml version="1.0" encoding="utf-8"?>
<com.rnturboimagepicker.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp"
    android:background="@android:color/transparent"
    android:foreground="@android:color/transparent"
    android:stateListAnimator="@null">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/image_card_background"
        android:foreground="@android:color/transparent"
        android:stateListAnimator="@null">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:scaleType="centerCrop"
                android:background="@color/image_placeholder_background"
                android:contentDescription="갤러리 이미지" />

            <!-- Live camera preview for the camera cell -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:implementationMode="compatible"
                app:scaleType="fillCenter"
                android:visibility="gone" />
                
            <!-- Cached frame to show while camera is loading -->
            <ImageView
                android:id="@+id/cameraLastFrameView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Permission prompt text -->
            <TextView
                android:id="@+id/permissionPromptText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                android:padding="8dp"
                android:text="Tap to allow camera"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Placeholder icon for loading/caching state -->
            <ImageView
                android:id="@+id/placeholderIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_image_placeholder"
                android:visibility="gone"
                android:contentDescription="이미지 로딩 중" />

            <!-- Selection overlay -->
            <View
                android:id="@+id/selectionOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="#80000000"
                android:visibility="gone" />

            <!-- Camera icon overlay (visible only on the camera cell) -->
            <ImageView
                android:id="@+id/cameraOverlayIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="4dp"
                android:padding="6dp"
                android:src="@drawable/ic_camera"
                android:visibility="gone"
                app:tint="@android:color/white" />

            <!-- Selection checkmark (single selection mode) -->
            <ImageView
                android:id="@+id/checkmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="8dp"
                android:src="@android:drawable/checkbox_on_background"
                android:background="@android:drawable/presence_online"
                android:padding="4dp"
                android:visibility="gone"
                app:tint="@color/bottom_sheet_primary_tint" />

            <!-- Selection badge container (Multi-selection mode) -->
            <FrameLayout
                android:id="@+id/selectionBadgeContainer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp">

                <!-- Selection circle border -->
                <View
                    android:id="@+id/selectionCircleBorder"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_border_white"
                    android:visibility="gone" />

                <!-- Selection number badge -->
                <TextView
                    android:id="@+id/selectionNumber"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/circle_filled_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Invisible Touch Area for Selection (1/3 of the cell) -->
            <View
                android:id="@+id/selectionTouchArea"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.33"
                app:layout_constraintHeight_percent="0.33"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@android:color/transparent"
                android:foreground="@android:color/transparent"
                android:stateListAnimator="@null"
                android:clickable="true"
                android:focusable="true" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</com.rnturboimagepicker.SquareFrameLayout>
