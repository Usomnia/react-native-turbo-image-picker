<?xml version="1.0" encoding="utf-8"?>
<com.rnturboimagepicker.PullToDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pullToDismissLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-area crop container — extends behind status bar, circle overlay draws the crop guide -->
        <FrameLayout
            android:id="@+id/cropContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomTools"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.rnturboimagepicker.ZoomableImageView
                android:id="@+id/zoomableImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.rnturboimagepicker.CircleDashedOverlayView
                android:id="@+id/circleOverlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Bottom Tools Area -->
        <LinearLayout
            android:id="@+id/bottomTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/editor_bar_background"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/turbo_cancel"
                    android:textColor="@color/editor_foreground"
                    android:textSize="15sp"
                    android:textAllCaps="false"/>

                <ImageButton
                    android:id="@+id/btnRotate"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/rotate_icon"
                    android:tint="@color/editor_foreground"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/btnConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_ok"
                    android:text="@string/turbo_done"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </FrameLayout>

            <View
                android:id="@+id/navBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.rnturboimagepicker.PullToDismissLayout>
