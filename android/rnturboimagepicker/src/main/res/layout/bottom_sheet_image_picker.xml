<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Selected count indicator (bottom) -->
    <LinearLayout
        android:id="@+id/selectedCountLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/bottom_sheet_selected_count_bg"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectedCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selected_count"
            android:textSize="14sp"
            android:textColor="@color/bottom_sheet_text_secondary" />

    </LinearLayout>

    <!-- RecyclerView with FastScroller Container -->
    <FrameLayout
        android:id="@+id/recyclerViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/selectedCountLayout"
        android:layout_alignParentTop="true"
        android:background="@color/bottom_sheet_background">

        <!-- RecyclerView for image grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imageRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:clipToPadding="false"
            android:overScrollMode="always"
            android:scrollbars="none" />

        <!-- Loading Indicator (hidden - not used) -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateDrawable="@drawable/custom_thin_spinner"
            android:indeterminateTint="@color/bottom_sheet_icon_tint"
            android:visibility="gone" />

        <!-- Quick Scroller: Date Scroll Indicator (draggable with extended touch area) -->
        <FrameLayout
            android:id="@+id/dateScrollIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginEnd="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:elevation="12dp"
            android:clickable="false"
            android:focusable="false">
            
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/date_indicator_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                
                <TextView
                    android:id="@+id/dateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/date_indicator_text" />
            </FrameLayout>
        </FrameLayout>

        <!-- Quick Scroller: Track (visual only, not touchable) -->
        <View
            android:id="@+id/scrollBarTrack"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginEnd="0dp"
            android:background="@android:color/transparent"
            android:alpha="0"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false"
            android:elevation="10dp" />
        
        <!-- Quick Scroller: Track Visual (hidden) -->
        <View
            android:id="@+id/scrollBarTrackVisual"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:background="@drawable/scrollbar_track_background"
            android:alpha="0"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />

        <!-- Quick Scroller: Thumb (visual only, not touchable) -->
        <View
            android:id="@+id/scrollBarThumb"
            android:layout_width="40dp"
            android:layout_height="80dp"
            android:layout_gravity="end"
            android:layout_marginEnd="0dp"
            android:background="@android:color/transparent"
            android:alpha="0"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false"
            android:elevation="11dp" />
        
    <!-- Quick Scroller: Thumb Visual (hidden) -->
        <View
            android:id="@+id/scrollBarThumbVisual"
            android:layout_width="6dp"
            android:layout_height="50dp"
            android:layout_gravity="end"
            android:layout_marginEnd="11dp"
            android:background="@drawable/scrollbar_thumb_background"
            android:alpha="0"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />

    </FrameLayout>

    <!-- Gradient background for transparent topbar -->
    <View
        android:id="@+id/topbarGradient"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/topbar_gradient" />

    <!-- Header with tabs and check buttons -->
    <FrameLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/header_background">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Close Button (Left) -->
            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_close_x"
                android:background="@drawable/circle_close_button_background"
                android:contentDescription="닫기"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <!-- Album Title (Original UI - shown when no selection) -->
            <LinearLayout
                android:id="@+id/albumTitleLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true">
                
                <TextView
                    android:id="@+id/albumTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_recents"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bottom_sheet_text_primary" />
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/bottom_sheet_text_primary" />
            </LinearLayout>

            <!-- Tab Container (New UI - shown when selection exists) -->
            <FrameLayout
                android:id="@+id/tabContainer"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/tab_container_background"
                android:visibility="gone">
                
                <!-- Active background indicator (animated) -->
                <View
                    android:id="@+id/tabActiveIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/tab_all_active_background"
                    android:alpha="0" />
                
                <!-- Tab Buttons Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <!-- All Tab Button -->
                    <TextView
                        android:id="@+id/allTabButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/tab_all"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tab_active_text"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="0dp" />
                    
                    <!-- Selected Count Tab -->
                    <TextView
                        android:id="@+id/selectedCountTab"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text=""
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tab_inactive_text"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Done Button (Right) -->
            <TextView
                android:id="@+id/doneButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:text="@string/button_done"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_done_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </RelativeLayout>
    </FrameLayout>

</RelativeLayout>
